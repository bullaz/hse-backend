package com.stellarix.hse.dto;

import java.time.LocalDateTime;
import java.util.List;
import java.util.UUID;

import lombok.AllArgsConstructor;
import lombok.Builder;
import lombok.Data;
import lombok.NoArgsConstructor;

@Data
@Builder
@AllArgsConstructor
@NoArgsConstructor
public class WorkPermitVerifyResponse {

    private boolean valid;
    /** Null when valid=true. One of: INVALID_ID, WRONG_SITE, OUTSIDE_WINDOW, REVOKED, EXPIRED */
    private String reason;
    private String permitId;
    private String siteName;
    private LocalDateTime startDatetime;
    private LocalDateTime endDatetime;
    private List<IntervenantDto> intervenants;

    @Data
    @AllArgsConstructor
    @NoArgsConstructor
    public static class IntervenantDto {
        private UUID inductionId;
        private String firstName;
        private String lastName;
    }
}
